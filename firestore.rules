rules_version = '2';

// 権限マトリクス（技術仕様書 5章）をそのままルール化したもの。
// クライアント側のJSで画面を隠すだけでなく、ここで実際にアクセスを制限する。

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- ヘルパー関数 ----

    function isSignedIn() {
      return request.auth != null;
    }

    // 本部アカウントかどうか（Firebase Authのカスタムクレームで管理）
    function isHonbu() {
      return isSignedIn() && request.auth.token.role == 'honbu';
    }

    // 世話人・講師のスタッフドキュメントを取得
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.staffId)).data;
    }

    function isStaffFor(group) {
      return isSignedIn()
        && request.auth.token.role == 'staff'
        && group in staffDoc().groups;
    }

    function isSewaninFor(group) {
      return isStaffFor(group) && staffDoc().role == 'sewanin';
    }

    function isTeacherFor(group) {
      return isStaffFor(group) && staffDoc().role == 'teacher';
    }

    // 許状申請（licenseRequests）は本部稽古（名月会・茶道教室・Gマダムの茶の湯講座）のみ対象。
    // 宗徧流稽古側のグループでは、スタッフの役割（世話人・講師）に関わらず許状申請の機能自体を使わない。
    function isHonbuKeikoGroup(group) {
      return group in ['名月会', '茶道教室', 'Gマダムの茶の湯講座'];
    }

    // 本人（マイページ）かどうか
    function isSelf(memberId) {
      return isSignedIn() && request.auth.token.memberId == memberId;
    }

    // ---- members（会員） ----
    match /members/{memberId} {
      allow read: if isHonbu()
        || isStaffFor(resource.data.group)
        || isSelf(memberId);

      // 本部は全項目を編集可
      allow write: if isHonbu();

      // 世話人は自分の担当する会の会員のステータス・出席・支払い方法のみ編集可
      allow update: if isSewaninFor(resource.data.group)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'attendance', 'paymentStatus', 'paymentMethod']);

      // 本人は連絡先とRSVP・出欠のみ編集可（許状段階やステータスは変更不可）
      // 出欠は、マイページの「出欠登録」ボタンが今月分の出席簿セルを直接更新するために必要。
      allow update: if isSelf(memberId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['email', 'phone', 'address', 'rsvp', 'attendance']);

      // 講師は自分の担当する会の会員の出席のみ編集可
      allow update: if isTeacherFor(resource.data.group)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['attendance']);

      // 公開の入会フォーム（/enroll、未ログイン）からの新規作成のみ許可。
      // 許可される値をかなり狭く固定することで、なりすまし作成や項目の不正混入を防ぐ。
      // 注：Cloud Functionsが使えるようになったら、スパム防止のためこちらの経路を
      //     コールアブル関数（Callable Functions）に置き換えることを推奨。
      allow create: if request.resource.data.status == '在籍'
        && request.resource.data.groupCategory == '本部稽古'
        && request.resource.data.license == '入門'
        && request.resource.data.paymentStatus == '未納'
        && request.resource.data.rsvp == '未回答'
        && request.resource.data.group in ['名月会', 'Gマダムの茶の湯講座']
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.keys().hasOnly([
             'id', 'name', 'nameKana', 'birthDate', 'guardian', 'guardianKana', 'grade',
             'occupation', 'otherLessons', 'healthNotes', 'emergencyContact', 'expectations',
             'group', 'groupCategory', 'license', 'joinDate', 'status', 'paymentMethod',
             'paymentStatus', 'rsvp', 'email', 'phone', 'address', 'createdAt'
           ]);
    }

    // ---- counters（会員番号の自動採番。/enroll から更新される） ----
    match /counters/{counterId} {
      allow read: if true;
      // 初回作成：合意済みの開始値からのみ許可
      allow create: if counterId == 'members' && request.resource.data.next == 30000071;
      // 更新：必ず1つずつ進める（飛び番・巻き戻しを禁止）
      allow update: if counterId == 'members'
        && request.resource.data.next == resource.data.next + 1;
    }

    // ---- staff（スタッフ） ----
    match /staff/{staffId} {
      allow read: if isHonbu() || (isSignedIn() && request.auth.token.staffId == staffId);
      allow write: if isHonbu(); // スタッフの登録・削除は本部のみ
    }

    // ---- licenseRequests（許状申請） ----
    match /licenseRequests/{requestId} {
      allow read: if isHonbu() || (isStaffFor(resource.data.group) && isHonbuKeikoGroup(resource.data.group));

      // 講師：新規作成は可能（ただし本部稽古のグループのみ）
      allow create: if isTeacherFor(request.resource.data.group)
        && isHonbuKeikoGroup(request.resource.data.group);

      // 本部：全ステータス変更可
      allow update: if isHonbu();

      // 講師：「発行済」→「お渡し済」の変更のみ可（他のフィールドは変更不可、本部稽古のグループのみ）
      allow update: if isTeacherFor(resource.data.group)
        && isHonbuKeikoGroup(resource.data.group)
        && resource.data.status == '発行済'
        && request.resource.data.status == 'お渡し済'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']);

      allow delete: if isHonbu();
    }

    // ---- leaveRequests（退会・休会・復会申請） ----
    match /leaveRequests/{requestId} {
      allow read: if isHonbu() || isStaffFor(resource.data.group) || isSelf(resource.data.memberId);

      // 本人が新規申請
      allow create: if isSelf(request.resource.data.memberId)
        && request.resource.data.status == 'pending';

      // 承認・却下は本部のみ
      allow update: if isHonbu();
    }

    // ---- notifications（通知ログ） ----
    match /notifications/{notifId} {
      allow read: if isHonbu();
      allow write: if false; // Cloud Functionsからのみ書き込み（クライアントからは書けない）
    }

    // ---- paymentEvents（入金イベント：Square Webhook経由） ----
    match /paymentEvents/{eventId} {
      allow read: if isHonbu();
      allow write: if false; // Cloud Functions（Square Webhook受信用）からのみ
    }

    // ---- meta（Googleカレンダーから同期した「次回のお稽古」日など） ----
    match /meta/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Cloud Functions（Googleカレンダー同期）からのみ
    }

    // ---- meta/g1ShippingDoc（G1＝Gマダムの茶の湯講座の発送物リスト。本部と担当講師が編集可） ----
    match /meta/g1ShippingDoc {
      allow write: if isHonbu() || isStaffFor('Gマダムの茶の湯講座');
    }

    // ---- g1ShippingLogs（G1の発送記録アーカイブ。発送のたびに1件作成） ----
    match /g1ShippingLogs/{logId} {
      allow read: if isHonbu() || isStaffFor('Gマダムの茶の湯講座');
      allow create, update: if isHonbu() || isStaffFor('Gマダムの茶の湯講座');
      allow delete: if isHonbu();
    }

    // ---- meta/nyumonSetInventory（名月会の入門セット在庫。本部が管理画面で編集し、
    //      新規入門時はCloud Functions（Admin SDK、ルール適用外）が自動的に数量を減らす） ----
    match /meta/nyumonSetInventory {
      allow write: if isHonbu();
    }
  }
}
